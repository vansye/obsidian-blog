# setup-demo generates fresh credentials in .env. Never commit .env.
DB_PASSWORD=replace-with-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-different-random-root-password
REDIS_PASSWORD=replace-with-random-redis-password
# Empty disables webhook. Generate a random value to enable it.
VAULT_WEBHOOK_SECRET=
HOST_BIND=127.0.0.1
PORT=8080
SITE_NAME=我的博客
SITE_DESCRIPTION=记录学习、生活与创造。
SITE_AUTHOR=作者
SITE_URL=http://localhost:8080
SITE_GITHUB=
SITE_EMAIL=
PUBLISH_ROOT=博客
CORS_ORIGINS=
SYNC_FETCH_ENABLED=false
SYNC_STARTUP_ENABLED=true
SYNC_POLL_ENABLED=true
SYNC_POLL_INTERVAL=PT10M
SYNC_POLL_INITIAL_DELAY=PT10M
